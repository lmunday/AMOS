      <bpmn:association id="Association_1yip8wi" associationDirection="None" sourceRef="assigncustomer" targetRef="TextAnnotation_161wazx" />
    </bpmn:subProcess>
    <bpmn:subProcess id="displayMenuProcess" name="Display Menu">
      <bpmn:incoming>Flow_0wktth0</bpmn:incoming>
      <bpmn:outgoing>Flow_0bkbyjx</bpmn:outgoing>
      <bpmn:startEvent id="startDisplayMenu" name="startDisplayMenu">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
