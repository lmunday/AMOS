      <bpmn:endEvent id="endDisplayWelcome" name="endDisplayWelcome">
        <bpmn:incoming>Flow_0gstcvk</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0gstcvk" sourceRef="assigncustomer" targetRef="endDisplayWelcome" />
      <bpmn:startEvent id="startDisplayWelcome" name="startDisplayWelcome">
        <bpmn:outgoing>Flow_1l6f9eo</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1l6f9eo" sourceRef="startDisplayWelcome" targetRef="requestCustomerInput" />
