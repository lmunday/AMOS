      <bpmn:sequenceFlow id="Flow_0efnh18" sourceRef="startDisplayMenu" targetRef="Gateway_1tvo8xx" />
      <bpmn:userTask id="displayMenu" name="Display Menu">
        <bpmn:documentation>Need to create input variables for display on the form.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="DisplayMenuAndOrder" />
          <zeebe:ioMapping>
            <zeebe:output source="=orderedItem" target="tableUi.orderedItem" />
            <zeebe:output source="=numberOrdered" target="tableUi.numberOrdered" />
            <zeebe:output source="=orderPlaced" target="tableUi.orderPlaced" />
            <zeebe:output source="=billRequested" target="tableUi.billRequested" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0r8k2hk</bpmn:incoming>
        <bpmn:outgoing>Flow_13jm5fr</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="displayMenuItemReceived" name="displayMenuItemReceived">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=append(menuItemList, {&#34;name&#34;:menuItemName, &#34;description&#34;: menuItemDescription, &#34;cost&#34;:menuItemCost, &#34;category&#34;:menuItemCategory})" target="menuItemList" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0q26mcv</bpmn:incoming>
        <bpmn:outgoing>Flow_154ujqq</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0mlgz5r" messageRef="Message_3ns2e5i" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gateway_1tvo8xx">
        <bpmn:incoming>Flow_0efnh18</bpmn:incoming>
        <bpmn:incoming>Flow_154ujqq</bpmn:incoming>
        <bpmn:outgoing>Flow_0yb4yz6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0q26mcv" sourceRef="Gateway_1psk3s8" targetRef="displayMenuItemReceived" />
      <bpmn:endEvent id="endDisplayMenu" name="endDisplayMenu">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=[]" target="menuItemList" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0g8piuo</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_154ujqq" sourceRef="displayMenuItemReceived" targetRef="Gateway_1tvo8xx" />
      <bpmn:sequenceFlow id="Flow_11jm6de" sourceRef="Gateway_1psk3s8" targetRef="Event_0qvrke8" />
      <bpmn:intermediateCatchEvent id="Event_0qvrke8" name="Wait For Menu Items">
        <bpmn:documentation>Create the menuItemList attribute from the variable.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=menuItemList" target="tableUi.menuItemList" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_11jm6de</bpmn:incoming>
        <bpmn:outgoing>Flow_188rlvt</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_0lcdaex">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10s</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_0yb4yz6" sourceRef="Gateway_1tvo8xx" targetRef="Gateway_1psk3s8" />
      <bpmn:sequenceFlow id="Flow_188rlvt" sourceRef="Event_0qvrke8" targetRef="Activity_1tvtu0e" />
      <bpmn:exclusiveGateway id="Gateway_0iom603" name="Order Placed?">
        <bpmn:incoming>Flow_13jm5fr</bpmn:incoming>
        <bpmn:outgoing>Flow_1r0z23a</bpmn:outgoing>
        <bpmn:outgoing>Flow_1tadkd3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_13jm5fr" sourceRef="displayMenu" targetRef="Gateway_0iom603" />
      <bpmn:sequenceFlow id="Flow_1r0z23a" name="Yes" sourceRef="Gateway_0iom603" targetRef="Activity_14p8vmn">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tableUi.orderPlaced=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sendTask id="Activity_14p8vmn" name="Place Order" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_placeOrder" target="messageName" />
            <zeebe:input source="tableUi.customerId" target="correlationKey" />
            <zeebe:input source="={&#34;orderedItem&#34;:tableUi.orderedItem, &#34;numberOrdered&#34;:tableUi.numberOrdered}" target="variables" />
            <zeebe:input source="publish" target="correlationType.type" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1r0z23a</bpmn:incoming>
        <bpmn:outgoing>Flow_198vaog</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="Gateway_1psk3s8" name="All Menu Items Received?">
        <bpmn:incoming>Flow_0yb4yz6</bpmn:incoming>
        <bpmn:outgoing>Flow_0q26mcv</bpmn:outgoing>
        <bpmn:outgoing>Flow_11jm6de</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:sequenceFlow id="Flow_1tadkd3" name="No" sourceRef="Gateway_0iom603" targetRef="Gateway_0rex5qb">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tableUi.orderPlaced=false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sendTask id="billRequested" name="Bill Requested" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_requestBill" target="messageName" />
            <zeebe:input source="tableUi.customerId" target="correlationKey" />
            <zeebe:input source="publish" target="correlationType.type" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0tre2hb</bpmn:incoming>
        <bpmn:outgoing>Flow_0g8piuo</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="Gateway_0odbksb" name="Bill Requested?">
        <bpmn:incoming>Flow_0orsi8j</bpmn:incoming>
        <bpmn:outgoing>Flow_0tre2hb</bpmn:outgoing>
        <bpmn:outgoing>Flow_0wfsiwx</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0tre2hb" name="Yes" sourceRef="Gateway_0odbksb" targetRef="billRequested">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tableUi.billRequested=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0g8piuo" sourceRef="billRequested" targetRef="endDisplayMenu" />
      <bpmn:exclusiveGateway id="Gateway_1yims4r">
        <bpmn:incoming>Flow_0wfsiwx</bpmn:incoming>
        <bpmn:incoming>Flow_034p6qh</bpmn:incoming>
        <bpmn:incoming>Flow_11rv8sl</bpmn:incoming>
        <bpmn:outgoing>Flow_0r8k2hk</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0wfsiwx" name="No" sourceRef="Gateway_0odbksb" targetRef="Gateway_1yims4r">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tableUi.billRequested=false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0r8k2hk" sourceRef="Gateway_1yims4r" targetRef="displayMenu" />
      <bpmn:sequenceFlow id="Flow_198vaog" sourceRef="Activity_14p8vmn" targetRef="Gateway_0rex5qb" />
      <bpmn:exclusiveGateway id="Gateway_0rex5qb">
        <bpmn:incoming>Flow_1tadkd3</bpmn:incoming>
        <bpmn:incoming>Flow_198vaog</bpmn:incoming>
        <bpmn:outgoing>Flow_0orsi8j</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0orsi8j" sourceRef="Gateway_0rex5qb" targetRef="Gateway_0odbksb" />
      <bpmn:boundaryEvent id="updateOrder" name="updateOrder" attachedToRef="displayMenu">
        <bpmn:documentation>//orderedFoodName is received
//Get the position in the order list of the orderedFoodName</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=index of(orderList.name,tableUi.orderedFoodName)" target="tableUi.orderListIndex" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_1ignvmr</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1fkyeel" messageRef="Message_3dh9b80" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_034p6qh" sourceRef="Activity_1wm22i2" targetRef="Gateway_1yims4r" />
      <bpmn:sequenceFlow id="Flow_1ignvmr" sourceRef="updateOrder" targetRef="Activity_1wm22i2" />
      <bpmn:scriptTask id="Activity_1wm22i2" name="Set Ordered Food To Prepared">
        <bpmn:documentation>//Set the prepared flag of the menu item at that index in the orderList to true</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=orderList[tableUi.orderListIndex[1]].prepared=true" resultVariable="orderList" />
          <zeebe:ioMapping>
            <zeebe:output source="=orderList" target="tableUi.orderList" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1ignvmr</bpmn:incoming>
        <bpmn:outgoing>Flow_034p6qh</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_11rv8sl" sourceRef="generateOrderPreparedList" targetRef="Gateway_1yims4r" />
      <bpmn:scriptTask id="Activity_1tvtu0e" name="Generate The Order List">
        <bpmn:documentation>Create an order list from the menu item list containing the menu item name, number ordered and whether it has been prepared or not.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=for menuItem in menuItemList return {&#34;name&#34;:menuItem.name, &#34;number&#34;:0, &#34;prepared&#34;:false}" resultVariable="orderList" />
          <zeebe:ioMapping>
            <zeebe:output source="=orderList" target="tableUi.orderList" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_188rlvt</bpmn:incoming>
        <bpmn:outgoing>Flow_1n0x1vw</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1n0x1vw" sourceRef="Activity_1tvtu0e" targetRef="generateOrderNamesList" />
      <bpmn:sequenceFlow id="Flow_1tr1gb5" sourceRef="generateOrderNamesList" targetRef="generateOrderPreparedList" />
      <bpmn:scriptTask id="generateOrderNamesList" name="Generate Order Names List">
        <bpmn:extensionElements>
          <zeebe:script expression="=for name in tableUi.orderList.name return name" resultVariable="orderListNames" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1n0x1vw</bpmn:incoming>
        <bpmn:outgoing>Flow_1tr1gb5</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="generateOrderPreparedList" name="Generate Order Prepared List">
        <bpmn:extensionElements>
          <zeebe:script expression="=for prepared in tableUi.orderList.prepared return prepared" resultVariable="orderListPrepared" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1tr1gb5</bpmn:incoming>
        <bpmn:outgoing>Flow_11rv8sl</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:textAnnotation id="TextAnnotation_0zq53bd">
        <bpmn:text>The Append command does not work with an attribute, so convert menuItemList to a variable.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0v59u1p" associationDirection="None" sourceRef="displayMenuItemReceived" targetRef="TextAnnotation_0zq53bd" />
      <bpmn:association id="Association_148jooj" associationDirection="None" sourceRef="TextAnnotation_0zq53bd" targetRef="startDisplayMenu" />
      <bpmn:textAnnotation id="TextAnnotation_0f0dg8f">
        <bpmn:text>the menu will be displayed, even if not all menu items are returned in time,</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_1hriwvy" associationDirection="None" sourceRef="Event_0qvrke8" targetRef="TextAnnotation_0f0dg8f" />
      <bpmn:textAnnotation id="TextAnnotation_1vcp2cx">
        <bpmn:text>Separate tests allows the user to place their order and request their bill at the same time.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0su0i68" associationDirection="None" sourceRef="Flow_0tre2hb" targetRef="TextAnnotation_1vcp2cx" />
    </bpmn:subProcess>
    <bpmn:subProcess id="displayReceiptActivity" name="Display Receipt">
      <bpmn:incoming>Flow_0w8cjn3</bpmn:incoming>
      <bpmn:outgoing>Flow_1s6ttyw</bpmn:outgoing>
      <bpmn:sequenceFlow id="Flow_1ua17og" sourceRef="startDisplayReceipt" targetRef="Gateway_0y44t30" />
      <bpmn:exclusiveGateway id="Gateway_1irpwwf" name="copyRequested?" default="Flow_0s10o5p">
        <bpmn:incoming>Flow_0y6ebor</bpmn:incoming>
        <bpmn:outgoing>Flow_06jdoh6</bpmn:outgoing>
        <bpmn:outgoing>Flow_0s10o5p</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0y6ebor" sourceRef="displaReceipt" targetRef="Gateway_1irpwwf" />
      <bpmn:sequenceFlow id="Flow_06jdoh6" name="Yes" sourceRef="Gateway_1irpwwf" targetRef="Activity_0vsvo07">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=copyReceipt=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0sesvzk" name="Yes" sourceRef="Gateway_02bhsde" targetRef="Activity_1fzx9a1">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=tableAvailable=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:userTask id="displaReceipt" name="Display Receipt">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="DisplayReceipt" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0lwcu9g</bpmn:incoming>
        <bpmn:outgoing>Flow_0y6ebor</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="Activity_0vsvo07" name="Copy Receipt" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_copyReceipt" target="messageName" />
            <zeebe:input source="=tableUi.location" target="correlationKey" />
            <zeebe:input source="publish" target="correlationType.type" />
          </zeebe:ioMapping>
