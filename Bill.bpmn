      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bill.amount&lt;=0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:scriptTask id="calculateAmount" name="Calculate Amount">
      <bpmn:extensionElements>
        <zeebe:script expression="=cost*taxRate/100" resultVariable="tax" />
        <zeebe:ioMapping>
          <zeebe:input source="=bill.taxRate" target="taxRate" />
          <zeebe:input source="=bill.cost" target="cost" />
          <zeebe:output source="=tax" target="bill.tax" />
          <zeebe:output source="=tax+cost" target="bill.amount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tn01lq</bpmn:incoming>
      <bpmn:outgoing>Flow_029zzuv</bpmn:outgoing>
