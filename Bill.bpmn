    <bpmn:scriptTask id="calculateAmount" name="Calculate Amount">
      <bpmn:extensionElements>
        <zeebe:script expression="=cost*taxRate/100" resultVariable="tax" />
        <zeebe:ioMapping>
          <zeebe:input source="=taxRate" target="taxRate" />
          <zeebe:input source="=cost" target="cost" />
          <zeebe:output source="=tax" target="tax" />
          <zeebe:output source="=cost+tax" target="amountOwed" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
