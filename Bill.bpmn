    <bpmn:sequenceFlow id="Flow_10cn3e1" sourceRef="Activity_16zx89e" targetRef="Gateway_0e8jck3" />
    <bpmn:scriptTask id="initializeBill" name="Calculate Bill">
      <bpmn:extensionElements>
        <zeebe:script expression="=(1+taxRate/100)*cost" resultVariable="amount" />
        <zeebe:ioMapping>
          <zeebe:input source="=bill.taxRate" target="taxRate" />
          <zeebe:input source="=bill.cost" target="cost" />
          <zeebe:output source="=amount" target="bill.amount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0d5gkyn</bpmn:incoming>
      <bpmn:outgoing>Flow_18ezgxs</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_16zx89e" name="Calculate Tax">
      <bpmn:extensionElements>
        <zeebe:script expression="=cost*taxRate/100" resultVariable="tax" />
        <zeebe:ioMapping>
          <zeebe:input source="=bill.taxRate" target="taxRate" />
          <zeebe:input source="=bill.cost" target="cost" />
          <zeebe:output source="=tax" target="bill.tax" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18ezgxs</bpmn:incoming>
      <bpmn:outgoing>Flow_10cn3e1</bpmn:outgoing>
    </bpmn:scriptTask>
  </bpmn:process>
