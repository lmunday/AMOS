<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1y2kcjw" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="69d2c1a" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_1k4fnnm">
    <bpmn:participant id="orderedFood" name="Ordered Food" processRef="orderedFoodProcess">
      <bpmn:documentation>{
"orderedFood" : 
		{
		"customerId": "",
		"foodDelivered": false,
		"nmberOrderd": 0
		}
}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:textAnnotation id="TextAnnotation_1rh09sb">
      <bpmn:text>To Order</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ba0c3h" associationDirection="None" sourceRef="returnOrderedFoodIdentifier" targetRef="TextAnnotation_1rh09sb" />
    <bpmn:textAnnotation id="TextAnnotation_121bnpv">
      <bpmn:text>To Kitchen UI</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1i2dums" associationDirection="None" sourceRef="sendOrderedFoodtoKitchen" targetRef="TextAnnotation_121bnpv" />
    <bpmn:textAnnotation id="TextAnnotation_1eecznk">
      <bpmn:text>To Table UI</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_09ehvsv">
      <bpmn:text>Added string(orderNumber)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0kcmk36" associationDirection="None" sourceRef="createOrderedFood" targetRef="TextAnnotation_09ehvsv" />
    <bpmn:association id="Association_1b2ch71" associationDirection="None" sourceRef="displayPreparedFood" targetRef="TextAnnotation_1eecznk" />
  </bpmn:collaboration>
  <bpmn:process id="orderedFoodProcess" name="Ordered Food Process" isExecutable="true">
    <bpmn:sendTask id="sendOrderedFoodtoKitchen" name="Send Ordered Food To Kitchen" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_displayOrderedFood" target="messageName" />
          <zeebe:input source="=orderedFood.restaurantId" target="correlationKey" />
          <zeebe:input source="={&#34;id&#34;:orderedFood.id, &#34;name&#34;:orderedFood.name, &#34;numberOrdered&#34;:orderedFood.numberOrdered, &#34;tableLocation&#34;:orderedFood.tableLocation, &#34;instructions&#34;:orderedFood.instructions&#10;}" target="variables" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0f3yi9v</bpmn:incoming>
      <bpmn:outgoing>Flow_1diqlaw</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_0d5gkyn" sourceRef="createOrderedFood" targetRef="returnOrderedFoodIdentifier" />
    <bpmn:sequenceFlow id="Flow_0f3yi9v" sourceRef="returnOrderedFoodIdentifier" targetRef="sendOrderedFoodtoKitchen" />
    <bpmn:sequenceFlow id="Flow_1diqlaw" sourceRef="sendOrderedFoodtoKitchen" targetRef="Gateway_0ix2p5r" />
    <bpmn:sendTask id="returnOrderedFoodIdentifier" name="Return Ordered Food Identifier" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_returnOrderedFoodId" target="messageName" />
          <zeebe:input source="=orderedFood.customerId" target="correlationKey" />
          <zeebe:input source="={&#34;orderedFoodId&#34;:orderedFood.id}" target="variables" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0d5gkyn</bpmn:incoming>
      <bpmn:outgoing>Flow_0f3yi9v</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="createOrderedFood" name="Create Ordered Food">
      <bpmn:documentation>Need number ordered to create  a unique ID.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=menuItemName" target="orderedFood.name" />
          <zeebe:output source="=numberOrdered" target="orderedFood.numberOrdered" />
          <zeebe:output source="=false" target="orderedFood.prepared" />
          <zeebe:output source="=tableLocation" target="orderedFood.tableLocation" />
          <zeebe:output source="=customerId+menuItemName+string(orderNumber)" target="orderedFood.id" />
          <zeebe:output source="=customerId" target="orderedFood.customerId" />
          <zeebe:output source="=&#34;&#34;" target="orderedFood.instructions" />
          <zeebe:output source="=restaurantId" target="orderedFood.restaurantId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0d5gkyn</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1290pyo" messageRef="Message_2glir42" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="preparedOrderedFood" name="preparedOrderedFood">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=true" target="orderedFood.prepared" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16h4jt0</bpmn:incoming>
      <bpmn:outgoing>Flow_13wd6nl</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_17bdvhk" messageRef="Message_3i2ommo" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="displayPreparedFood" name="Display Prepared Food" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_updateOrder" target="messageName" />
          <zeebe:input source="=orderedFood.tableLocation" target="correlationKey" />
          <zeebe:input source="={&#34;name&#34;:orderedFood.name, &#34;number&#34;:orderedFood.numberOrdered}" target="variables" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13wd6nl</bpmn:incoming>
      <bpmn:outgoing>Flow_1ih87p5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_0pjw0ze">
      <bpmn:incoming>Flow_1xxawb7</bpmn:incoming>
      <bpmn:outgoing>Flow_16h4jt0</bpmn:outgoing>
      <bpmn:outgoing>Flow_0sxzf1m</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_16h4jt0" sourceRef="Gateway_0pjw0ze" targetRef="preparedOrderedFood" />
    <bpmn:sequenceFlow id="Flow_13wd6nl" sourceRef="preparedOrderedFood" targetRef="displayPreparedFood" />
    <bpmn:sequenceFlow id="Flow_0x9eqhw" sourceRef="deleteOrderedFood" targetRef="classNameDeleted" />
    <bpmn:sequenceFlow id="Flow_0sxzf1m" sourceRef="Gateway_0pjw0ze" targetRef="deleteOrderedFood" />
    <bpmn:exclusiveGateway id="Gateway_0ix2p5r">
      <bpmn:incoming>Flow_1diqlaw</bpmn:incoming>
      <bpmn:incoming>Flow_1ih87p5</bpmn:incoming>
      <bpmn:outgoing>Flow_1xxawb7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1xxawb7" sourceRef="Gateway_0ix2p5r" targetRef="Gateway_0pjw0ze" />
    <bpmn:sequenceFlow id="Flow_1ih87p5" sourceRef="displayPreparedFood" targetRef="Gateway_0ix2p5r" />
    <bpmn:intermediateCatchEvent id="deleteOrderedFood" name="deleteOrderedFood">
      <bpmn:incoming>Flow_0sxzf1m</bpmn:incoming>
      <bpmn:outgoing>Flow_0x9eqhw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0m8875v" messageRef="Message_17v6so0" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="classNameDeleted" name="Deleted">
      <bpmn:incoming>Flow_0x9eqhw</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
