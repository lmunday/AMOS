  <bpmn:collaboration id="MenuItem">
    <bpmn:documentation>{
"menuItem":{
	"name": "Elephant",
	"description": "Describe the menu item elephant.",
	"cost": 10,
	"category": "starter"}
}</bpmn:documentation>
    <bpmn:participant id="menuItem" name="Menu Item" processRef="menuItemProcess">
      <bpmn:documentation>{
"menuItem" : 
		{
		"menuItemId": "",
		"description": "",
		"cost": 0.00
		}
}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:textAnnotation id="TextAnnotation_03h7ws2">
      <bpmn:text>To menu to populate a customer menu item</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0x74bnm">
      <bpmn:text>From Menu</bpmn:text>
