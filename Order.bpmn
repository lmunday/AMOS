        <bpmn:outgoing>Flow_0ocv6q7</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_0ocv6q7" sourceRef="getOrderedFoodItem" targetRef="orderedFoodtoDelete" />
      <bpmn:sendTask id="deleteOrderedFoodItem" name="Delete Ordered Food Item" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_deleteOrderedFood" target="messageName" />
            <zeebe:input source="=orderedFoodId" target="correlationKey" />
