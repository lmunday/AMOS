    <bpmn:intermediateCatchEvent id="placeOrder" name="placeOrder">
      <bpmn:documentation>Receives
"orderedItems": [
    {
      "numberOrdered": "5",
      "name": "Cd"
    },
    {
      "numberOrdered": "4",
      "name": "Ef"
    },
    {
      "name": "Ab",
      "numberOrdered": 3
    }
  ]</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=orderedItems" target="order.orderedItems" />
          <zeebe:output source="=order.orderNumber+1" target="order.orderNumber" />
          <zeebe:output source="=orderCost" target="order.cost" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07o0pp3</bpmn:incoming>
      <bpmn:outgoing>Flow_1u8kh0f</bpmn:outgoing>
