      <bpmn:exclusiveGateway id="orderedFoodtoDelete" name="Ordered Food To Delete?">
        <bpmn:incoming>Flow_0ocv6q7</bpmn:incoming>
        <bpmn:outgoing>Flow_1wc5vy1</bpmn:outgoing>
        <bpmn:outgoing>Flow_0npe1k0</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0sh8iw1" sourceRef="deleteOrderedFoodItem" targetRef="Gateway_0nxe4gf" />
      <bpmn:sequenceFlow id="Flow_0npe1k0" name="No" sourceRef="orderedFoodtoDelete" targetRef="orderedFoodDeleted">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderedFoodId=null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1wc5vy1" name="Yes" sourceRef="orderedFoodtoDelete" targetRef="deleteOrderedFoodItem">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderedFoodId!=null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:endEvent id="orderDeleted" name="Order Deleted">
      <bpmn:incoming>Flow_0j6bfuc</bpmn:incoming>
    </bpmn:endEvent>
