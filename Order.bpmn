  <bpmn:collaboration id="orderDiagram">
    <bpmn:documentation>{"order":{
"tableLocation": "FL",
"restaurantId": "AMOS",
"customerId": "BaldrickFL",
"orderedItems":[],
"orderedItemIds": [],
"cost": 2.5,
"orderNumber": 0}
}</bpmn:documentation>
    <bpmn:participant id="order" name="Order" processRef="orderProcess">
      <bpmn:documentation>{
"order" : 
		{
		"customerId": ""
		}
}</bpmn:documentation>
    </bpmn:participant>
    <bpmn:textAnnotation id="TextAnnotation_1dj9jrl">
      <bpmn:text>Keep a record of the number of times order is placed, so that the ordered item ID is unique no matter how many times it is ordered.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ykldc7" associationDirection="None" sourceRef="placeOrder" targetRef="TextAnnotation_1dj9jrl" />
  </bpmn:collaboration>
