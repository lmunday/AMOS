      <bpmn:sequenceFlow id="Flow_1ms03cn" sourceRef="Gateway_0nxe4gf" targetRef="getOrderedFoodItem" />
      <bpmn:scriptTask id="getOrderedFoodItem" name="Get Ordered Food Item">
        <bpmn:documentation>Get the name of the next ordered menu item</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=(orderedItemIds[index])" resultVariable="orderedFoodId" />
          <zeebe:ioMapping>
