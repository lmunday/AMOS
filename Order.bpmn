    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="orderMenuItems" name="Order Menu Items">
      <bpmn:incoming>Flow_0knggwh</bpmn:incoming>
      <bpmn:outgoing>Flow_1sypaqa</bpmn:outgoing>
      <bpmn:sendTask id="createOrderedFood" name="Create Ordered Food" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_createOrderedFood" target="messageName" />
            <zeebe:input source="={&#34;menuItemName&#34;:menuItemName,&#10;&#34;numberOrdered&#34;:numberOrdered,&#10;&#34;tableLocation&#34;:order.tableLocation,&#10;&#34;customerId&#34;:order.customerId,&#10;&#34;orderNumber&#34;:orderNumber,&#10;&#34;restaurantId&#34;:order.restaurantId,&#10;&#34;instructions&#34;:instructions}" target="variables" />
            <zeebe:input source="publish" target="correlationType.type" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0e59ury</bpmn:incoming>
        <bpmn:outgoing>Flow_1qtuehy</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="Gateway_07cycus">
        <bpmn:incoming>Flow_0d35nsp</bpmn:incoming>
        <bpmn:incoming>Flow_1g8vrwk</bpmn:incoming>
        <bpmn:outgoing>Flow_1bu7g9a</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_1bu7g9a" sourceRef="Gateway_07cycus" targetRef="forEachOrderedITem" />
      <bpmn:exclusiveGateway id="Gateway_1ycjqhd" name="More To Create?">
        <bpmn:incoming>Flow_0xrjypu</bpmn:incoming>
        <bpmn:outgoing>Flow_17o65rv</bpmn:outgoing>
        <bpmn:outgoing>Flow_0e59ury</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_17o65rv" name="No" sourceRef="Gateway_1ycjqhd" targetRef="Event_0vhjowc">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=menuItemName=null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="Event_0vhjowc" name="end">
        <bpmn:incoming>Flow_17o65rv</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0e59ury" name="Yes" sourceRef="Gateway_1ycjqhd" targetRef="createOrderedFood">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=menuItemName!=null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:startEvent id="startOrder" name="start">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=order.orderedItems" target="orderedItems" />
            <zeebe:output source="=1" target="index" />
            <zeebe:output source="=0" target="orderNumber" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0d35nsp</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0d35nsp" sourceRef="startOrder" targetRef="Gateway_07cycus" />
      <bpmn:sequenceFlow id="Flow_0xrjypu" sourceRef="forEachOrderedITem" targetRef="Gateway_1ycjqhd" />
      <bpmn:scriptTask id="forEachOrderedITem" name="For Each Ordered Item">
        <bpmn:documentation>[1] removes the brackets from the result.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=orderedItems[index]" resultVariable="orderedItem" />
          <zeebe:ioMapping>
            <zeebe:output source="=index+1" target="index" />
            <zeebe:output source="=orderedItem.name" target="menuItemName" />
            <zeebe:output source="=orderedItem.numberOrdered" target="numberOrdered" />
            <zeebe:output source="=orderNumber+1" target="orderNumber" />
            <zeebe:output source="=orderedItem.instructions" target="instructions" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1bu7g9a</bpmn:incoming>
        <bpmn:outgoing>Flow_0xrjypu</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:intermediateCatchEvent id="returnOrderedFoodId" name="returnOrderedFoodId">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=concatenate(order.orderedItemIds,orderedFoodId)" target="order.orderedItemIds" />
            <zeebe:output source="=order.customerId+menuItemName" target="customerMenuItemId" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1qtuehy</bpmn:incoming>
        <bpmn:outgoing>Flow_1g8vrwk</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0bmvnnu" messageRef="Message_2bf5d89" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_1qtuehy" sourceRef="createOrderedFood" targetRef="returnOrderedFoodId" />
      <bpmn:sequenceFlow id="Flow_1g8vrwk" sourceRef="returnOrderedFoodId" targetRef="Gateway_07cycus" />
      <bpmn:textAnnotation id="TextAnnotation_02ih7kg">
        <bpmn:text>Get the name and number ordered</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0dwgpef" associationDirection="None" sourceRef="forEachOrderedITem" targetRef="TextAnnotation_02ih7kg" />
      <bpmn:textAnnotation id="TextAnnotation_1fu2a4b">
        <bpmn:text>orderedItems are only for this placed order.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_17r07np" associationDirection="None" sourceRef="startOrder" targetRef="TextAnnotation_1fu2a4b" />
      <bpmn:textAnnotation id="TextAnnotation_1m14kht">
        <bpmn:text>From ordered food</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_1o91pcr" associationDirection="None" sourceRef="returnOrderedFoodId" targetRef="TextAnnotation_1m14kht" />
      <bpmn:textAnnotation id="TextAnnotation_12jt204">
        <bpmn:text>orderNumber keeps a count of the number of items ordered</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_04i1in7" associationDirection="None" sourceRef="forEachOrderedITem" targetRef="TextAnnotation_12jt204" />
    </bpmn:subProcess>
    <bpmn:sendTask id="sendBillRequested" name="Send Bill Requested" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
