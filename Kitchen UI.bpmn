      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="createKitchenUi" name="createKitchenUi">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=restaurantId" target="kitchenUi.restaurantId" />
          <zeebe:output source="=[]" target="kitchenUi.orderedItems" />
          <zeebe:output source="=[]" target="kitchenUi.preparedItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_05v5zx6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1100ltv" messageRef="Message_3nq22bt" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1wi7l65">
      <bpmn:incoming>noMorePrepared</bpmn:incoming>
      <bpmn:incoming>Flow_15xnhw5</bpmn:incoming>
      <bpmn:incoming>Flow_05v5zx6</bpmn:incoming>
      <bpmn:outgoing>Flow_1y1zxg9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="updateOrderedItems" name="Update Ordered Items">
      <bpmn:extensionElements>
        <zeebe:script expression="=concatenate(orderedItems, orderedItem)" resultVariable="orderedItems" />
        <zeebe:ioMapping>
          <zeebe:input source="=kitchenUi.orderedItems" target="orderedItems" />
          <zeebe:output source="=orderedItems" target="kitchenUi.orderedItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fhpz7p</bpmn:incoming>
      <bpmn:outgoing>Flow_15xnhw5</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="kitchenUIDeleted" name="Kitchen UI Deleted">
      <bpmn:incoming>Flow_1n2nmfd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="displayOrderdFood" name="Display Ordered Food">
      <bpmn:documentation>Displays 
kitchenUi.orderedItems
Returns
preparedItems sorted from highest to lowest.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="kitchenUi" />
        <zeebe:ioMapping>
          <zeebe:input source="=[]" target="preparedItems" />
          <zeebe:output source="=sort(preparedItems, function(x, y) x &#62; y)" target="kitchenUi.preparedItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1y1zxg9</bpmn:incoming>
      <bpmn:outgoing>Flow_12tpmfv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1ud2r0d">
      <bpmn:incoming>Flow_12tpmfv</bpmn:incoming>
      <bpmn:incoming>Flow_1nfin3w</bpmn:incoming>
      <bpmn:outgoing>Flow_1wg2luw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="deleteKitchenUi" name="deleteKitchenUi" attachedToRef="displayOrderdFood">
      <bpmn:outgoing>Flow_1n2nmfd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1a2aot0" messageRef="Message_3lftq39" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="displayOrderedFood" name="displayOrderedFood" attachedToRef="displayOrderdFood">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={&#34;id&#34;:id, &#34;name&#34;:name, &#34;numberOrdered&#34;:numberOrdered, &#34;tableLocation&#34;:tableLocation, &#34;instructions&#34;:instructions, &#34;prepared&#34;:false}" target="orderedItem" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0fhpz7p</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_19v2oph" messageRef="Message_19ckb64" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_05v5zx6" sourceRef="createKitchenUi" targetRef="Gateway_1wi7l65" />
    <bpmn:sequenceFlow id="noMorePrepared" name="no" sourceRef="Gateway_1sc4lxv" targetRef="Gateway_1wi7l65">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(kitchenUi.preparedItems)=0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15xnhw5" sourceRef="updateOrderedItems" targetRef="Gateway_1wi7l65" />
    <bpmn:sequenceFlow id="Flow_1y1zxg9" sourceRef="Gateway_1wi7l65" targetRef="displayOrderdFood" />
    <bpmn:sequenceFlow id="Flow_0fhpz7p" sourceRef="displayOrderedFood" targetRef="updateOrderedItems" />
    <bpmn:sequenceFlow id="Flow_1n2nmfd" sourceRef="deleteKitchenUi" targetRef="kitchenUIDeleted" />
    <bpmn:sequenceFlow id="Flow_12tpmfv" sourceRef="displayOrderdFood" targetRef="Gateway_1ud2r0d" />
    <bpmn:sequenceFlow id="Flow_0vkk0c5" sourceRef="removeFoodFromOrderedItems" targetRef="Gateway_1e6xowz" />
    <bpmn:sequenceFlow id="morePreparedItems" name="yes" sourceRef="Gateway_1sc4lxv" targetRef="createPreparedItemIndex">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(kitchenUi.preparedItems)&gt;0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="id" name="yes" sourceRef="Gateway_1y8tzu7" targetRef="preparedOrderedFood" />
    <bpmn:sequenceFlow id="Flow_1jpg5n0" sourceRef="preparedOrderedFood" targetRef="removeFoodFromOrderedItems" />
    <bpmn:sequenceFlow id="Flow_1wg2luw" sourceRef="Gateway_1ud2r0d" targetRef="Gateway_1sc4lxv" />
    <bpmn:exclusiveGateway id="Gateway_1sc4lxv" name="Prepared Items&#62;0?">
      <bpmn:incoming>Flow_1wg2luw</bpmn:incoming>
      <bpmn:outgoing>morePreparedItems</bpmn:outgoing>
      <bpmn:outgoing>noMorePrepared</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="getThePreparedOrderedFoodId" name="Get The Prepared Ordered Food ID">
      <bpmn:documentation>For each prepared item index received from the UI.
Find the ordered food ID at the location given by the value of that index, in the ordered food list.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="=orderedItems[preparedItemIndex].id" resultVariable="orderedItemId" />
        <zeebe:ioMapping>
          <zeebe:input source="=kitchenUi.orderedItems" target="orderedItems" />
          <zeebe:input source="=kitchenUi.preparedItems" target="preparedItems" />
          <zeebe:output source="=if orderedItemId=[]&#10;then null&#10;else orderedItemId" target="orderedItemId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kawcdk</bpmn:incoming>
      <bpmn:outgoing>Flow_0knf72i</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="createPreparedItemIndex" name="Create Prepared Item Index">
      <bpmn:extensionElements>
        <zeebe:script expression="=number(kitchenUi.preparedItems[1])" resultVariable="preparedItemIndex" />
      </bpmn:extensionElements>
      <bpmn:incoming>morePreparedItems</bpmn:incoming>
      <bpmn:outgoing>Flow_1kawcdk</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1kawcdk" sourceRef="createPreparedItemIndex" targetRef="getThePreparedOrderedFoodId" />
    <bpmn:sequenceFlow id="Flow_1nfin3w" sourceRef="removeFromPreparedItems" targetRef="Gateway_1ud2r0d" />
    <bpmn:sendTask id="preparedOrderedFood" name="Prepared Ordered Food" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_preparedOrderedFood" target="messageName" />
          <zeebe:input source="=orderedItemId" target="correlationKey" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>id</bpmn:incoming>
      <bpmn:outgoing>Flow_1jpg5n0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_0knf72i" sourceRef="getThePreparedOrderedFoodId" targetRef="Gateway_1y8tzu7" />
    <bpmn:exclusiveGateway id="Gateway_1y8tzu7" name="Ordered Item ID?" default="id">
      <bpmn:incoming>Flow_0knf72i</bpmn:incoming>
      <bpmn:outgoing>id</bpmn:outgoing>
      <bpmn:outgoing>Flow_0tj66ad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0tj66ad" name="null" sourceRef="Gateway_1y8tzu7" targetRef="Activity_0sd793q">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderedItemId=null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:scriptTask id="removeFromPreparedItems" name="Remove From Prepared Items List">
      <bpmn:extensionElements>
        <zeebe:script expression="=remove(preparedItems, 1)" resultVariable="preparedItems" />
        <zeebe:ioMapping>
          <zeebe:input source="=kitchenUi.preparedItems" target="preparedItems" />
          <zeebe:output source="=preparedItems" target="kitchenUi.preparedItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04ivwuf</bpmn:incoming>
      <bpmn:outgoing>Flow_1nfin3w</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_04ivwuf" sourceRef="Gateway_1e6xowz" targetRef="removeFromPreparedItems" />
    <bpmn:scriptTask id="removeFoodFromOrderedItems" name="Remove From Ordered Items">
      <bpmn:extensionElements>
        <zeebe:script expression="=remove(orderedItems, preparedItemIndex)" resultVariable="orderedItems" />
        <zeebe:ioMapping>
          <zeebe:input source="=kitchenUi.orderedItems" target="orderedItems" />
          <zeebe:output source="=orderedItems" target="kitchenUi.orderedItems" />
          <zeebe:output source="=index+1" target="index" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1jpg5n0</bpmn:incoming>
      <bpmn:outgoing>Flow_0vkk0c5</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1e6xowz">
      <bpmn:incoming>Flow_0vkk0c5</bpmn:incoming>
      <bpmn:incoming>Flow_1rxi132</bpmn:incoming>
      <bpmn:outgoing>Flow_04ivwuf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1rxi132" sourceRef="Activity_0sd793q" targetRef="Gateway_1e6xowz" />
    <bpmn:userTask id="Activity_0sd793q" name="Pause">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="waitABit" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0tj66ad</bpmn:incoming>
      <bpmn:outgoing>Flow_1rxi132</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
