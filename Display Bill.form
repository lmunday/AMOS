{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "69d2c1a"
  },
  "schemaVersion": 19,
  "id": "DisplayBill",
  "components": [
    {
      "text": "# Table Display",
      "type": "text",
      "layout": {
        "row": "Row_0walmd9",
        "columns": null
      },
      "id": "Field_1qccnfr"
    },
    {
      "label": "Assitance Requested",
      "type": "checkbox",
      "layout": {
        "row": "Row_0walmd9",
        "columns": 6
      },
      "id": "Field_0vik8xc",
      "key": "requestStatus",
      "readonly": true
    },
    {
      "label": "Customer",
      "type": "textfield",
      "layout": {
        "row": "Row_0f0zlqe",
        "columns": null
      },
      "id": "Field_1b8m1rk",
      "key": "customerId",
      "readonly": true
    },
    {
      "label": "Table",
      "type": "textfield",
      "layout": {
        "row": "Row_0f0zlqe",
        "columns": 3
      },
      "id": "Field_1jt5bw4",
      "key": "location",
      "readonly": true
    },
    {
      "label": "Bill",
      "components": [
        {
          "label": "Tax",
          "type": "textfield",
          "layout": {
            "row": "Row_0vfo522",
            "columns": null
          },
          "id": "Field_1hz97me",
          "key": "billTax",
          "readonly": true
        },
        {
          "label": "Cost",
          "type": "textfield",
          "layout": {
            "row": "Row_0vfo522",
            "columns": null
          },
          "id": "Field_1nhhrlr",
          "key": "billCost",
          "readonly": true
        },
        {
          "label": "Amount Owed",
          "type": "textfield",
          "layout": {
            "row": "Row_0vfo522",
            "columns": null
          },
          "id": "Field_1oh906m",
          "key": "billAmount"
        },
        {
          "label": "Payment Method",
          "values": [
            {
              "label": "Visa",
              "value": "visa"
            },
            {
              "label": "PayPal",
              "value": "paypal"
            },
            {
              "label": "Master Card",
              "value": "masterCard"
            },
            {
              "label": "Cash",
              "value": "cash"
            },
            {
              "label": "Canadian Tyre",
              "value": "cdnTire"
            }
          ],
          "type": "select",
          "layout": {
            "row": "Row_04aze2m",
            "columns": null
          },
          "id": "Field_1tx6vll",
          "key": "paymentMethod",
          "validate": {
            "required": true
          }
        },
        {
          "label": "Payment Amount",
          "type": "number",
          "layout": {
            "row": "Row_04aze2m",
            "columns": null
          },
          "id": "Field_1mcc0r8",
          "key": "payment",
          "validate": {
            "required": true,
            "min": "1.00"
          },
          "defaultValue": 1,
          "increment": "0.01"
        },
        {
          "label": "Payment Information",
          "type": "textarea",
          "layout": {
            "row": "Row_0rgrfo1",
            "columns": null
          },
          "id": "Field_0rrs3ks",
          "key": "paymentInformation",
          "defaultValue": "Contains payment account information depending on the method used."
        }
      ],
      "showOutline": true,
      "type": "group",
      "layout": {
        "row": "Row_04sijle",
        "columns": null
      },
      "id": "Field_1bfjoap"
    }
  ],
  "type": "default"
