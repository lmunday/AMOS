      <bpmn:incoming>Flow_0pajekn</bpmn:incoming>
      <bpmn:outgoing>Flow_0xd9z6z</bpmn:outgoing>
      <bpmn:sequenceFlow id="Flow_1yfsmjp" sourceRef="startDisplayBill" targetRef="displayBill" />
      <bpmn:userTask id="displayBill" name="Display Bill">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="DisplayBill" />
          <zeebe:ioMapping>
            <zeebe:output source="=paymentMethod" target="tableUi.paymentMethod" />
            <zeebe:output source="=payment" target="tableUi.paymentAmount" />
            <zeebe:output source="=paymentInformation" target="tableUi.paymentInformation" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1yfsmjp</bpmn:incoming>
        <bpmn:outgoing>Flow_1d5smfj</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_1d5smfj" sourceRef="displayBill" targetRef="enteredPayment" />
      <bpmn:sendTask id="enteredPayment" name="Payment Entered" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_enteredPayment" target="messageName" />
            <zeebe:input source="=tableUi.customerId" target="correlationKey" />
            <zeebe:input source="={&#34;method&#34;:tableUi.paymentMethod, &#34;amount&#34;:tableUi.paymentAmount, &#34;information&#34;:tableUi.paymentInformation}" target="variables" />
            <zeebe:input source="publish" target="correlationType.type" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1d5smfj</bpmn:incoming>
        <bpmn:outgoing>Flow_12f6644</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="endDisplayBill" name="endDisplayBill">
        <bpmn:incoming>Flow_12f6644</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_12f6644" sourceRef="enteredPayment" targetRef="endDisplayBill" />
      <bpmn:startEvent id="startDisplayBill" name="startDisplayBill">
        <bpmn:outgoing>Flow_1yfsmjp</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:textAnnotation id="TextAnnotation_1k8p57x">
        <bpmn:text>tableUi.orderCost and billCost are the same thing, but billCost comes from Bill whereas orderCost comes from tableUi</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_16pmfmf" associationDirection="None" sourceRef="displayBill" targetRef="TextAnnotation_1k8p57x" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="displayMenuReceived" name="displayMenuReceived">
      <bpmn:incoming>Flow_1ux8otq</bpmn:incoming>
      <bpmn:outgoing>Flow_0wktth0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0onbd0t" messageRef="Message_05sn6ke" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="displayMenuProcess" name="Display Menu">
      <bpmn:incoming>Flow_0wktth0</bpmn:incoming>
      <bpmn:outgoing>Flow_0bkbyjx</bpmn:outgoing>
      <bpmn:startEvent id="startDisplayMenu" name="startDisplayMenu">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=[]" target="menuItems" />
            <zeebe:output source="=tableUi.orderedItems" target="orderedItems" />
            <zeebe:output source="=[]" target="preparedItems" />
            <zeebe:output source="=[]" target="selectedItems" />
            <zeebe:output source="=0" target="selectedItemCost" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0efnh18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0efnh18" sourceRef="startDisplayMenu" targetRef="Gateway_1tvo8xx" />
      <bpmn:userTask id="displayMenu" name="Display Menu">
        <bpmn:documentation>Need to create input variables for display on the form.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="DisplayMenuAndOrder" />
          <zeebe:ioMapping>
            <zeebe:input source="=null" target="selectedItem" />
            <zeebe:input source="=tableUi.orderCost+selectedItemCost" target="displayedCost" />
            <zeebe:output source="=if (placeMyOrder or iWantMyBill) then numberOrdered = 0 else numberOrdered" target="numberOrdered" />
            <zeebe:output source="=placeMyOrder" target="orderPlaced" />
            <zeebe:output source="=iWantMyBill" target="billRequested" />
            <zeebe:output source="=if (placeMyOrder or iWantMyBill) then selectedItems else append(selectedItems, {&#34;name&#34;:selectedItem, &#34;numberOrdered&#34;:numberOrdered})&#10;  " target="selectedItems" />
            <zeebe:output source="=if (placeMyOrder or iWantMyBill) then selectedItem = null else selectedItem" target="selectedItem" />
            <zeebe:output source="=instructions" target="instructions" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0r8k2hk</bpmn:incoming>
        <bpmn:outgoing>Flow_13jm5fr</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="displayMenuItemReceived" name="displayMenuItemReceived">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=append(menuItems, {&#34;name&#34;:menuItemName, &#34;description&#34;: menuItemDescription, &#34;cost&#34;:menuItemCost, &#34;category&#34;:menuItemCategory,&#34;numberOrdered&#34;:0})" target="menuItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0q26mcv</bpmn:incoming>
        <bpmn:outgoing>Flow_154ujqq</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0mlgz5r" messageRef="Message_3ns2e5i" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gateway_1tvo8xx">
        <bpmn:incoming>Flow_0efnh18</bpmn:incoming>
        <bpmn:incoming>Flow_154ujqq</bpmn:incoming>
        <bpmn:outgoing>Flow_0yb4yz6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0q26mcv" sourceRef="allMenuItemsReceived" targetRef="displayMenuItemReceived" />
      <bpmn:endEvent id="endDisplayMenu" name="endDisplayMenu">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=[]" target="tableUi.menuItems" />
            <zeebe:output source="=orderedItems" target="tableUi.orderedItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0g8piuo</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_154ujqq" sourceRef="displayMenuItemReceived" targetRef="Gateway_1tvo8xx" />
      <bpmn:sequenceFlow id="Flow_11jm6de" sourceRef="allMenuItemsReceived" targetRef="Event_0qvrke8" />
      <bpmn:intermediateCatchEvent id="Event_0qvrke8" name="Wait For Menu Items">
        <bpmn:documentation>Create the menuItemList attribute from the variable.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=menuItemList" target="tableUi.menuItemList" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_11jm6de</bpmn:incoming>
        <bpmn:outgoing>Flow_188rlvt</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_0lcdaex">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10s</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_0yb4yz6" sourceRef="Gateway_1tvo8xx" targetRef="allMenuItemsReceived" />
      <bpmn:sequenceFlow id="Flow_188rlvt" sourceRef="Event_0qvrke8" targetRef="generateOrderList" />
      <bpmn:exclusiveGateway id="orderPlaced" name="Order Placed?" default="Flow_1tadkd3">
        <bpmn:incoming>Flow_13jm5fr</bpmn:incoming>
        <bpmn:outgoing>Flow_1r0z23a</bpmn:outgoing>
        <bpmn:outgoing>Flow_1tadkd3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_13jm5fr" sourceRef="displayMenu" targetRef="orderPlaced" />
      <bpmn:sequenceFlow id="Flow_1r0z23a" name="yes" sourceRef="orderPlaced" targetRef="updateOrderedItemCost">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderPlaced=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:eventBasedGateway id="allMenuItemsReceived" name="All Menu Items Received?">
        <bpmn:incoming>Flow_0yb4yz6</bpmn:incoming>
        <bpmn:outgoing>Flow_0q26mcv</bpmn:outgoing>
        <bpmn:outgoing>Flow_11jm6de</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:sequenceFlow id="Flow_1tadkd3" name="no" sourceRef="orderPlaced" targetRef="Gateway_0odbksb" />
      <bpmn:sendTask id="billRequested" name="Bill Requested" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_requestBill" target="messageName" />
            <zeebe:input source="=tableUi.customerId" target="correlationKey" />
            <zeebe:input source="={&#34;orderCost&#34;:tableUi.orderCost}" target="variables" />
            <zeebe:input source="publish" target="correlationType.type" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0tre2hb</bpmn:incoming>
        <bpmn:outgoing>Flow_0g8piuo</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="Gateway_0odbksb" name="Bill Requested?" default="Flow_0wfsiwx">
        <bpmn:incoming>Flow_1tadkd3</bpmn:incoming>
        <bpmn:outgoing>Flow_0tre2hb</bpmn:outgoing>
        <bpmn:outgoing>Flow_0wfsiwx</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0tre2hb" name="yes" sourceRef="Gateway_0odbksb" targetRef="billRequested">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=billRequested=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0g8piuo" sourceRef="billRequested" targetRef="endDisplayMenu" />
      <bpmn:exclusiveGateway id="Gateway_1yims4r">
        <bpmn:incoming>Flow_0ancbmo</bpmn:incoming>
        <bpmn:incoming>Flow_1n0x1vw</bpmn:incoming>
        <bpmn:incoming>Flow_1ignvmr</bpmn:incoming>
        <bpmn:incoming>Flow_1ds0s9d</bpmn:incoming>
        <bpmn:incoming>Flow_08lgpgk</bpmn:incoming>
        <bpmn:outgoing>Flow_0r8k2hk</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0wfsiwx" name="no" sourceRef="Gateway_0odbksb" targetRef="Gateway_07fzscw" />
      <bpmn:sequenceFlow id="Flow_0r8k2hk" sourceRef="Gateway_1yims4r" targetRef="displayMenu" />
      <bpmn:boundaryEvent id="updateOrder" name="updateOrder" attachedToRef="displayMenu">
        <bpmn:documentation>//orderedFoodName is received
//Get the position in the order list of the orderedFoodName</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=append(preparedItems, {&#34;name&#34;:name, &#34;number&#34;:number, &#34;instructions&#34;:instructions})" target="preparedItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_1ignvmr</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1fkyeel" messageRef="Message_3dh9b80" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_1ignvmr" sourceRef="updateOrder" targetRef="Gateway_1yims4r" />
      <bpmn:scriptTask id="generateOrderList" name="Generate List Of Names To Order">
        <bpmn:documentation>Create  list of menu item names that can be ordered.
Set number ordered to 0, order prepared to empty</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=for menuItem in menuItems return menuItem.name" resultVariable="displayedNames" />
          <zeebe:ioMapping>
            <zeebe:output source="=0" target="numberOrdered" />
            <zeebe:output source="=displayedNames" target="displayedNames" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_188rlvt</bpmn:incoming>
        <bpmn:outgoing>Flow_1n0x1vw</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1n0x1vw" sourceRef="generateOrderList" targetRef="Gateway_1yims4r" />
      <bpmn:sequenceFlow id="Flow_0kr2fmr" sourceRef="Activity_14vajal" targetRef="Activity_0i7e4cg" />
      <bpmn:scriptTask id="Activity_14vajal" name="Add Item To Selected Items List">
        <bpmn:documentation>Add the selected item name and numberOrdered to ther list of selectedItems.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=if numberOrdered &#62;0 then&#10;append(selectedItems, {&#34;name&#34;:selectedItem, &#34;numberOrdered&#34;:numberOrdered,&#34;instructions&#34;:instructions})&#10;else&#10;selectedItems" resultVariable="selectedItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=selectedItems" target="selectedItems" />
            <zeebe:output source="=&#34;&#34;" target="selectedItem" />
            <zeebe:output source="=1" target="numberOrdered" />
            <zeebe:output source="=&#34;&#34;" target="instructions" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1jnacjm</bpmn:incoming>
        <bpmn:outgoing>Flow_0kr2fmr</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_11mpssd" sourceRef="updateNumberOrderdDisplay" targetRef="removeSelectedItem" />
      <bpmn:scriptTask id="updateNumberOrderdDisplay" name="Update Number Ordered In Menu Display">
        <bpmn:extensionElements>
          <zeebe:script expression="=for menuItem in menuItems return &#10;    if menuItem.name = selectedItem &#10;    then put(menuItem, &#34;numberOrdered&#34;, numberOrdered ) &#10;    else menuItem" resultVariable="menuItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=menuItems" target="menuItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1d768dk</bpmn:incoming>
        <bpmn:outgoing>Flow_11mpssd</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="Gateway_07fzscw" name="Item Selected?">
        <bpmn:incoming>Flow_0wfsiwx</bpmn:incoming>
        <bpmn:outgoing>Flow_0ancbmo</bpmn:outgoing>
        <bpmn:outgoing>Flow_1d768dk</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0ancbmo" name="no" sourceRef="Gateway_07fzscw" targetRef="Gateway_1yims4r">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=selectedItem=null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1d768dk" name="yes" sourceRef="Gateway_07fzscw" targetRef="updateNumberOrderdDisplay">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=selectedItem!=null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:scriptTask id="updateOrderedItems" name="Update Ordered Items">
        <bpmn:documentation>orderedItems is a list of selectedItem objects. [1] is to remove the braces from each object as it is added to the list.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=concatenate(orderedItems, selectedItems)" resultVariable="orderedItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=[]" target="selectedItems" />
            <zeebe:output source="=orderedItems" target="orderedItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_04vr4aq</bpmn:incoming>
        <bpmn:outgoing>Flow_08w9wc5</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1ds0s9d" sourceRef="Activity_0i7e4cg" targetRef="Gateway_1yims4r" />
      <bpmn:scriptTask id="updateOrderedItemCost" name="Update Cost Of Ordered Items">
        <bpmn:extensionElements>
          <zeebe:script expression="=orderCost+selectedItemCost" resultVariable="orderCost" />
          <zeebe:ioMapping>
            <zeebe:input source="=tableUi.orderCost" target="orderCost" />
            <zeebe:output source="=orderCost" target="tableUi.orderCost" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1r0z23a</bpmn:incoming>
        <bpmn:outgoing>Flow_0a1aczn</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0i7e4cg" name="Update Cost Of Selected Items">
        <bpmn:extensionElements>
          <zeebe:script expression="=sum(for menuItem in menuItems return menuItem.cost * menuItem.numberOrdered)" resultVariable="selectedItemCost" />
          <zeebe:ioMapping>
            <zeebe:output source="=selectedItemCost" target="selectedItemCost" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0kr2fmr</bpmn:incoming>
        <bpmn:outgoing>Flow_1ds0s9d</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="removeSelectedItem" name="Remove Selected Item">
        <bpmn:documentation>Remove any items from selectedItems with a name selectedItem</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=selectedItems[item.name != selectedItem]" resultVariable="selectedItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=selectedItems" target="selectedItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_11mpssd</bpmn:incoming>
        <bpmn:outgoing>Flow_1jnacjm</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1jnacjm" sourceRef="removeSelectedItem" targetRef="Activity_14vajal" />
      <bpmn:sequenceFlow id="Flow_08lgpgk" sourceRef="resetSelectedItems" targetRef="Gateway_1yims4r" />
      <bpmn:scriptTask id="resetSelectedItems" name="Menu Items Number Selected Reset To Zero">
        <bpmn:extensionElements>
          <zeebe:script expression="=for menuItem in menuItems return {&#10;  name: menuItem.name,&#10;  numberOrdered: 0,&#10;  description: menuItem.description,&#10;  cost: menuItem.cost,&#10;  category: menuItem.category&#10;}" resultVariable="menuItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=menuItems" target="menuItems" />
            <zeebe:output source="=0" target="selectedItemCost" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_08w9wc5</bpmn:incoming>
        <bpmn:outgoing>Flow_08lgpgk</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_08w9wc5" sourceRef="updateOrderedItems" targetRef="resetSelectedItems" />
      <bpmn:sendTask id="placeOrder" name="Place Order" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>"selectedItems": [
    {
      "numberOrdered": "5",
      "name": "Cd"
    },
    {
      "numberOrdered": "4",
      "name": "Ef"
    },
    {
      "name": "Ab",
      "numberOrdered": 3
    }
  ]</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_placeOrder" target="messageName" />
            <zeebe:input source="=tableUi.customerId" target="correlationKey" />
            <zeebe:input source="={&#34;orderedItems&#34;:selectedItems, &#34;orderCost&#34;:tableUi.orderCost}" target="variables" />
            <zeebe:input source="publish" target="correlationType.type" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0a1aczn</bpmn:incoming>
        <bpmn:outgoing>Flow_04vr4aq</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_04vr4aq" sourceRef="placeOrder" targetRef="updateOrderedItems" />
      <bpmn:sequenceFlow id="Flow_0a1aczn" sourceRef="updateOrderedItemCost" targetRef="placeOrder" />
      <bpmn:textAnnotation id="TextAnnotation_0zq53bd">
        <bpmn:text>The Append command does not work with an attribute, so convert menuItemList to a variable.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0v59u1p" associationDirection="None" sourceRef="displayMenuItemReceived" targetRef="TextAnnotation_0zq53bd" />
      <bpmn:association id="Association_148jooj" associationDirection="None" sourceRef="TextAnnotation_0zq53bd" targetRef="startDisplayMenu" />
      <bpmn:textAnnotation id="TextAnnotation_0f0dg8f">
        <bpmn:text>the menu will be displayed, even if not all menu items are returned in time,</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_1hriwvy" associationDirection="None" sourceRef="Event_0qvrke8" targetRef="TextAnnotation_0f0dg8f" />
      <bpmn:textAnnotation id="TextAnnotation_1vcp2cx">
        <bpmn:text>Separate tests allows the user to place their order and request their bill at the same time.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0su0i68" associationDirection="None" sourceRef="Flow_0tre2hb" targetRef="TextAnnotation_1vcp2cx" />
    </bpmn:subProcess>
    <bpmn:intermediateThrowEvent id="endMenu" name="End Menu">
      <bpmn:incoming>Flow_0bkbyjx</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_01wsqeb" name="finish" />
