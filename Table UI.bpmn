        <bpmn:incoming>Flow_1tadkd3</bpmn:incoming>
        <bpmn:outgoing>Flow_0tre2hb</bpmn:outgoing>
        <bpmn:outgoing>Flow_0wfsiwx</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0tre2hb" name="yes" sourceRef="Gateway_0odbksb" targetRef="billRequested">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=billRequested=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
