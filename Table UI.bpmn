      <bpmn:boundaryEvent id="updateOrder" name="updateOrder" attachedToRef="displayMenu">
        <bpmn:documentation>//orderedFoodName is received
//Get the position in the order list of the orderedFoodName</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=append(preparedItems, {&#34;name&#34;:name, &#34;number&#34;:number, &#34;instructions&#34;:instructions})" target="preparedItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_1ignvmr</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1fkyeel" messageRef="Message_3dh9b80" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_1ignvmr" sourceRef="updateOrder" targetRef="Gateway_1yims4r" />
      <bpmn:scriptTask id="generateOrderList" name="Generate List Of Names To Order">
        <bpmn:documentation>Create  list of menu item names that can be ordered.
Set number ordered to 0, order prepared to empty</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=for menuItem in menuItems return menuItem.name" resultVariable="displayedNames" />
          <zeebe:ioMapping>
            <zeebe:output source="=0" target="numberOrdered" />
            <zeebe:output source="=displayedNames" target="displayedNames" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_188rlvt</bpmn:incoming>
        <bpmn:outgoing>Flow_1n0x1vw</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1n0x1vw" sourceRef="generateOrderList" targetRef="Gateway_1yims4r" />
      <bpmn:sequenceFlow id="Flow_0kr2fmr" sourceRef="Activity_14vajal" targetRef="Activity_0i7e4cg" />
      <bpmn:scriptTask id="Activity_14vajal" name="Add Item To Selected Items List">
        <bpmn:documentation>Add the selected item name and numberOrdered to ther list of selectedItems.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=if numberOrdered &#62;0 then&#10;append(selectedItems, {&#34;name&#34;:selectedItem, &#34;numberOrdered&#34;:numberOrdered,&#34;instructions&#34;:instructions})&#10;else&#10;selectedItems" resultVariable="selectedItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=selectedItems" target="selectedItems" />
            <zeebe:output source="=&#34;&#34;" target="selectedItem" />
            <zeebe:output source="=1" target="numberOrdered" />
            <zeebe:output source="=&#34;&#34;" target="instructions" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1jnacjm</bpmn:incoming>
        <bpmn:outgoing>Flow_0kr2fmr</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_11mpssd" sourceRef="updateNumberOrderdDisplay" targetRef="removeSelectedItem" />
      <bpmn:scriptTask id="updateNumberOrderdDisplay" name="Update Number Ordered In Menu Display">
        <bpmn:extensionElements>
          <zeebe:script expression="=for menuItem in menuItems return &#10;    if menuItem.name = selectedItem &#10;    then put(menuItem, &#34;numberOrdered&#34;, numberOrdered ) &#10;    else menuItem" resultVariable="menuItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=menuItems" target="menuItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1d768dk</bpmn:incoming>
        <bpmn:outgoing>Flow_11mpssd</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="Gateway_07fzscw" name="Item Selected?">
        <bpmn:incoming>Flow_0wfsiwx</bpmn:incoming>
        <bpmn:outgoing>Flow_0ancbmo</bpmn:outgoing>
        <bpmn:outgoing>Flow_1d768dk</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0ancbmo" name="no" sourceRef="Gateway_07fzscw" targetRef="Gateway_1yims4r">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=selectedItem=null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1d768dk" name="yes" sourceRef="Gateway_07fzscw" targetRef="updateNumberOrderdDisplay">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=selectedItem!=null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:scriptTask id="updateOrderedItems" name="Update Ordered Items">
        <bpmn:documentation>orderedItems is a list of selectedItem objects. [1] is to remove the braces from each object as it is added to the list.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=concatenate(orderedItems, selectedItems)" resultVariable="orderedItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=[]" target="selectedItems" />
            <zeebe:output source="=orderedItems" target="orderedItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_04vr4aq</bpmn:incoming>
        <bpmn:outgoing>Flow_08w9wc5</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1ds0s9d" sourceRef="Activity_0i7e4cg" targetRef="Gateway_1yims4r" />
      <bpmn:scriptTask id="updateOrderedItemCost" name="Update Cost Of Ordered Items">
        <bpmn:extensionElements>
          <zeebe:script expression="=orderCost+selectedItemCost" resultVariable="orderCost" />
          <zeebe:ioMapping>
            <zeebe:input source="=orderCost" target="orderCost" />
            <zeebe:output source="=orderCost" target="orderCost" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1r0z23a</bpmn:incoming>
        <bpmn:outgoing>Flow_0a1aczn</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0i7e4cg" name="Update Cost Of Selected Items">
        <bpmn:extensionElements>
          <zeebe:script expression="=sum(for menuItem in menuItems return menuItem.cost * menuItem.numberOrdered)" resultVariable="selectedItemCost" />
          <zeebe:ioMapping>
            <zeebe:output source="=selectedItemCost" target="selectedItemCost" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0kr2fmr</bpmn:incoming>
        <bpmn:outgoing>Flow_1ds0s9d</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="removeSelectedItem" name="Remove Selected Item">
        <bpmn:documentation>Remove any items from selectedItems with a name selectedItem</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=selectedItems[item.name != selectedItem]" resultVariable="selectedItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=selectedItems" target="selectedItems" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_11mpssd</bpmn:incoming>
        <bpmn:outgoing>Flow_1jnacjm</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1jnacjm" sourceRef="removeSelectedItem" targetRef="Activity_14vajal" />
      <bpmn:sequenceFlow id="Flow_08lgpgk" sourceRef="resetSelectedItems" targetRef="Gateway_1yims4r" />
      <bpmn:scriptTask id="resetSelectedItems" name="Menu Items Number Selected Reset To Zero">
        <bpmn:extensionElements>
          <zeebe:script expression="=for menuItem in menuItems return {&#10;  name: menuItem.name,&#10;  numberOrdered: 0,&#10;  description: menuItem.description,&#10;  cost: menuItem.cost,&#10;  category: menuItem.category&#10;}" resultVariable="menuItems" />
          <zeebe:ioMapping>
            <zeebe:output source="=menuItems" target="menuItems" />
            <zeebe:output source="=0" target="selectedItemCost" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_08w9wc5</bpmn:incoming>
        <bpmn:outgoing>Flow_08lgpgk</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_08w9wc5" sourceRef="updateOrderedItems" targetRef="resetSelectedItems" />
      <bpmn:sendTask id="placeOrder" name="Place Order" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>"selectedItems": [
    {
      "numberOrdered": "5",
      "name": "Cd"
    },
    {
      "numberOrdered": "4",
      "name": "Ef"
    },
    {
      "name": "Ab",
      "numberOrdered": 3
    }
  ]</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_placeOrder" target="messageName" />
            <zeebe:input source="=customerId" target="correlationKey" />
            <zeebe:input source="={&#34;orderedItems&#34;:selectedItems, &#34;orderCost&#34;:orderCost}" target="variables" />
            <zeebe:input source="publish" target="correlationType.type" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0a1aczn</bpmn:incoming>
        <bpmn:outgoing>Flow_04vr4aq</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_04vr4aq" sourceRef="placeOrder" targetRef="updateOrderedItems" />
      <bpmn:sequenceFlow id="Flow_0a1aczn" sourceRef="updateOrderedItemCost" targetRef="placeOrder" />
      <bpmn:textAnnotation id="TextAnnotation_0zq53bd">
        <bpmn:text>The Append command does not work with an attribute, so convert menuItemList to a variable.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0v59u1p" associationDirection="None" sourceRef="displayMenuItemReceived" targetRef="TextAnnotation_0zq53bd" />
      <bpmn:association id="Association_148jooj" associationDirection="None" sourceRef="TextAnnotation_0zq53bd" targetRef="startDisplayMenu" />
      <bpmn:textAnnotation id="TextAnnotation_0f0dg8f">
        <bpmn:text>the menu will be displayed, even if not all menu items are returned in time,</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_1hriwvy" associationDirection="None" sourceRef="Event_0qvrke8" targetRef="TextAnnotation_0f0dg8f" />
      <bpmn:textAnnotation id="TextAnnotation_1vcp2cx">
        <bpmn:text>Separate tests allows the user to place their order and request their bill at the same time.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0su0i68" associationDirection="None" sourceRef="Flow_0tre2hb" targetRef="TextAnnotation_1vcp2cx" />
    </bpmn:subProcess>
