        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="_enteredPayment" target="messageName" />
            <zeebe:input source="=customerId" target="correlationKey" />
