<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="69d2c1a" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="RestaurantUI">
    <bpmn:participant id="restaurantUI" name="Restaturant UI" processRef="restaurantUIProces" />
  </bpmn:collaboration>
  <bpmn:process id="restaurantUIProces" name="Restaurant UI Process" isExecutable="true">
    <bpmn:laneSet id="LaneSet_12qkn7d">
      <bpmn:lane id="updateRestaturantUIDisplay" name="Update Display">
        <bpmn:flowNodeRef>openRestaurant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initializeRestaurantUI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateRestaurantDisplay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>uiTurnedOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closeRestaurant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>restaurantTurnedOn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="monitorRestaurantUIInput" name="Monitor Input">
        <bpmn:flowNodeRef>Gateway_0p2iry0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>selectATable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0o2ju6h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateTableStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>informSelectedTable</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sendTask id="openRestaurant" name="Open Restaurant" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_openRestaurant" target="messageName" />
          <zeebe:input source="={&#34;restaurantId&#34;:restaurantUi.restaurantId}" target="variables" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0p0cweo</bpmn:incoming>
      <bpmn:outgoing>Flow_1t8x4xv</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="initializeRestaurantUI" name="Initialize Restaurant UI">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="OpenRestaurant" />
        <zeebe:ioMapping>
          <zeebe:output source="=restaurantId" target="restaurantUi.restaurantId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1cc7pcd</bpmn:incoming>
      <bpmn:outgoing>Flow_0p0cweo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0p2iry0">
      <bpmn:incoming>Flow_0ciwabh</bpmn:incoming>
      <bpmn:incoming>Flow_1t8x4xv</bpmn:incoming>
      <bpmn:incoming>Flow_1r3etzn</bpmn:incoming>
      <bpmn:outgoing>Flow_1aga161</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="selectATable" name="Select A Table">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="RestaurantScreen" />
        <zeebe:ioMapping>
          <zeebe:output source="=selectedTable" target="restaurantUi.tableLocation" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1aga161</bpmn:incoming>
      <bpmn:outgoing>Flow_16m1nqv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="updateRestaurantDisplay" name="Update Restaurant Display">
      <bpmn:documentation>If the table status is available add it to the availableTableList
Otherwise remove it from the availableTableList, if there.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="UpdateRestaurantDisplay" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04bgit9</bpmn:incoming>
      <bpmn:outgoing>Flow_1r3etzn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="uiTurnedOff" name="UI Turned Off">
      <bpmn:incoming>Flow_0n6i7nu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="closeRestaurant" name="Close Restaurant" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_closingTime" target="messageName" />
          <zeebe:input source="=restaurantUi.restaurantId" target="correlationKey" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14nec9f</bpmn:incoming>
      <bpmn:outgoing>Flow_0n6i7nu</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="Event_0o2ju6h" name="Open for 8 Hours" attachedToRef="selectATable">
      <bpmn:outgoing>Flow_14nec9f</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0snxe48">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT8H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="updateTableStatus" name="updateTableStatus" attachedToRef="selectATable">
      <bpmn:documentation>If the table status is available, add it to the available tables list.  Otherwise remove it from the available tables list.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=tableLocation" target="restaurantUi.Table_Location" />
          <zeebe:output source="=tableStatus" target="restaurantUi.Table_Status" />
          <zeebe:output source="=if (tableStatus=&#34;Available&#34;) then &#10;  append(restaurantUi.availableTableList, tableLocation)&#10;else&#10;  restaurantUi.availableTableList[item != tableLocation]" target="restaurantUi.availableTableList" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_04bgit9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_09d09y5" messageRef="Message_3v2o974" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0p0cweo" sourceRef="initializeRestaurantUI" targetRef="openRestaurant" />
    <bpmn:sequenceFlow id="Flow_1t8x4xv" sourceRef="openRestaurant" targetRef="Gateway_0p2iry0" />
    <bpmn:sequenceFlow id="Flow_1cc7pcd" sourceRef="restaurantTurnedOn" targetRef="initializeRestaurantUI" />
    <bpmn:sequenceFlow id="Flow_0ciwabh" sourceRef="informSelectedTable" targetRef="Gateway_0p2iry0" />
    <bpmn:sequenceFlow id="Flow_1r3etzn" sourceRef="updateRestaurantDisplay" targetRef="Gateway_0p2iry0" />
    <bpmn:sequenceFlow id="Flow_1aga161" sourceRef="Gateway_0p2iry0" targetRef="selectATable" />
    <bpmn:sequenceFlow id="Flow_16m1nqv" sourceRef="selectATable" targetRef="informSelectedTable" />
    <bpmn:sequenceFlow id="Flow_04bgit9" sourceRef="updateTableStatus" targetRef="updateRestaurantDisplay" />
    <bpmn:sequenceFlow id="Flow_0n6i7nu" sourceRef="closeRestaurant" targetRef="uiTurnedOff" />
    <bpmn:sequenceFlow id="Flow_14nec9f" sourceRef="Event_0o2ju6h" targetRef="closeRestaurant" />
    <bpmn:sendTask id="informSelectedTable" name="Inform Selected Table" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_selectTable" target="messageName" />
          <zeebe:input source="=restaurantUi.tableLocation" target="correlationKey" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16m1nqv</bpmn:incoming>
      <bpmn:outgoing>Flow_0ciwabh</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="restaurantTurnedOn" name="Restaurant Turned On">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=[]" target="restaurantUi.availableTableList" />
          <zeebe:output source="=&#34;&#34;" target="restaurantUi.restaurantId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1cc7pcd</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:signal id="Signal_1utck8k" name="_openingTime" />
  <bpmn:message id="Message_3v2o974" name="_updateTableStatus">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=restaurantUi.restaurantId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:signal id="Signal_29no56f" name="_closingTime" />
  <bpmn:message id="Message_16nev38" name="_createRestaurantUI" />
