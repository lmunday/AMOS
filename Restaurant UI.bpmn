        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14nec9f</bpmn:incoming>
      <bpmn:outgoing>Flow_008wcor</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="informSelectedTable" name="Inform Selected Table" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_selectTable" target="messageName" />
          <zeebe:input source="=tableLocation" target="correlationKey" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="0" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1wv27au</bpmn:incoming>
      <bpmn:outgoing>Flow_0ciwabh</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="selectATable" name="Select A Table">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="RestaurantScreen" />
        <zeebe:ioMapping>
          <zeebe:input source="=restaurantUi.availableTables" target="tableList" />
          <zeebe:output source="=selectedTable" target="tableLocation" />
          <zeebe:output source="=close" target="restaurantUi.close" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1aga161</bpmn:incoming>
      <bpmn:outgoing>Flow_16m1nqv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_14kfwqh" name="Close Restaurant?">
      <bpmn:incoming>Flow_16m1nqv</bpmn:incoming>
      <bpmn:outgoing>Flow_1wv27au</bpmn:outgoing>
      <bpmn:outgoing>Flow_14nec9f</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="updateTableStatus" name="updateTableStatus" attachedToRef="selectATable">
      <bpmn:documentation>If the table status is available, add it to the available tables list.  Otherwise remove it from the available tables list.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=tableLocation" target="tableLocation" />
          <zeebe:output source="=tableStatus" target="tableStatus" />
          <zeebe:output source="=seatingAvailable" target="seatingAvailable" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0xokp3b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_09d09y5" messageRef="Message_3v2o974" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_08uft46" sourceRef="updateAvailableTableSeating" targetRef="updateAvailableTables" />
    <bpmn:scriptTask id="updateAvailableTableSeating" name="Update Available Table Seating">
      <bpmn:extensionElements>
        <zeebe:script expression="=if count(tableSeating[name = tableLocation]) = 1&#10;then for table in tableSeating return if table.name = tableLocation then {&#34;name&#34;:tableLocation,&#34;seating&#34;:seatingAvailable,&#34;status&#34;:tableStatus} else table &#10;else append(tableSeating, {&#34;name&#34;:tableLocation,&#34;seating&#34;:seatingAvailable,&#34;status&#34;:tableStatus})" resultVariable="tableSeating" />
        <zeebe:ioMapping>
          <zeebe:input source="=restaurantUi.tableSeating" target="tableSeating" />
          <zeebe:input source="=tableLocation" target="tableLocation" />
          <zeebe:input source="=tableStatus" target="tableStatus" />
          <zeebe:output source="=tableSeating" target="restaurantUi.tableSeating" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xokp3b</bpmn:incoming>
      <bpmn:outgoing>Flow_08uft46</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_0p2iry0">
      <bpmn:incoming>Flow_0ciwabh</bpmn:incoming>
      <bpmn:incoming>Flow_1t8x4xv</bpmn:incoming>
      <bpmn:incoming>Flow_1r3etzn</bpmn:incoming>
      <bpmn:outgoing>Flow_1aga161</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="updateAvailableTables" name="Update Available Tables">
      <bpmn:documentation>If the table status is available add it to the availableTableList
Otherwise remove it from the availableTableList, if there.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="=if tableStatus = &#34;Available&#34; then&#10;if list contains(availableTables, tableLocation)&#10;then availableTables&#10;else append(availableTables, tableLocation)&#10;else availableTables[item != tableLocation]" resultVariable="availableTables" />
        <zeebe:ioMapping>
          <zeebe:input source="=tableStatus" target="tableStatus" />
          <zeebe:input source="=restaurantUi.availableTables" target="availableTables" />
          <zeebe:input source="=tableLocation" target="tableLocation" />
          <zeebe:output source="=availableTables" target="restaurantUi.availableTables" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08uft46</bpmn:incoming>
      <bpmn:outgoing>Flow_1r3etzn</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1r3etzn" sourceRef="updateAvailableTables" targetRef="Gateway_0p2iry0" />
    <bpmn:sequenceFlow id="Flow_0xokp3b" sourceRef="updateTableStatus" targetRef="updateAvailableTableSeating" />
    <bpmn:startEvent id="restaurantTurnedOn" name="Restaurant Turned On">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=[]" target="restaurantUi.availableTables" />
          <zeebe:output source="=&#34;&#34;" target="restaurantUi.restaurantId" />
          <zeebe:output source="=false" target="restaurantUi.close" />
          <zeebe:output source="=[{&#34;name&#34;:&#34;Location&#34;,&#34;seating&#34;:0,&#34;status&#34;:&#34;Not Available&#34;}]" target="restaurantUi.tableSeating" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1cc7pcd</bpmn:outgoing>
    </bpmn:startEvent>
