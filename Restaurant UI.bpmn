    <bpmn:sequenceFlow id="Flow_16m1nqv" sourceRef="selectATable" targetRef="Gateway_14kfwqh" />
    <bpmn:sequenceFlow id="Flow_14nec9f" name="yes" sourceRef="Gateway_14kfwqh" targetRef="closeRestaurant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=restaurantUi.close=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_008wcor" sourceRef="closeRestaurant" targetRef="allTablesDeleted" />
    <bpmn:sequenceFlow id="Flow_1cc7pcd" sourceRef="restaurantTurnedOn" targetRef="initializeRestaurant" />
    <bpmn:sequenceFlow id="Flow_0p0cweo" sourceRef="initializeRestaurant" targetRef="Gateway_0uriigm" />
    <bpmn:sequenceFlow id="Flow_1r7ukfw" sourceRef="deleteRestaurant" targetRef="restaurantClosed" />
    <bpmn:sequenceFlow id="Flow_0cwaodt" sourceRef="allTablesDeleted" targetRef="deleteKitchenUI" />
    <bpmn:sequenceFlow id="Flow_18jhuky" sourceRef="deleteKitchenUI" targetRef="deleteRestaurant" />
    <bpmn:sequenceFlow id="Flow_1wv27au" name="no" sourceRef="Gateway_14kfwqh" targetRef="informSelectedTable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=restaurantUi.close=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="deleteRestaurant" name="Delete Restaurant" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
