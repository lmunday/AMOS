          <zeebe:input source="={&#34;location&#34;:location, &#34;seatingAvailable&#34;:seatingAvailable, &#34;addTable&#34;:addTable}" target="variables" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
