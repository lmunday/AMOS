          <zeebe:output source="=[]" target="availableTables" />
          <zeebe:output source="=&#34;&#34;" target="restaurantId" />
          <zeebe:output source="=false" target="close" />
          <zeebe:output source="=[{&#34;name&#34;:&#34;Location&#34;,&#34;seating&#34;:0,&#34;status&#34;:&#34;Not Available&#34;}]" target="tableSeating" />
        </zeebe:ioMapping>
