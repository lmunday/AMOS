    <bpmn:sequenceFlow id="Flow_1bbndxg" sourceRef="Gateway_01qca6m" targetRef="displayUpdateTables" />
    <bpmn:sequenceFlow id="Flow_1dzs73l" sourceRef="updateTables" targetRef="Gateway_01qca6m" />
    <bpmn:userTask id="manageMenu" name="Manage Menu">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="manageMenu" />
        <zeebe:ioMapping>
          <zeebe:output source="=name" target="menuItemName" />
          <zeebe:output source="=cost" target="menuItemCost" />
