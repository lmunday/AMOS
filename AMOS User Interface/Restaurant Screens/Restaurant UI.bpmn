    <bpmn:sequenceFlow id="Flow_16m1nqv" sourceRef="selectATable" targetRef="Gateway_14kfwqh" />
    <bpmn:sequenceFlow id="Flow_14nec9f" name="yes" sourceRef="Gateway_14kfwqh" targetRef="closeRestaurant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=restaurantUi.close=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_008wcor" sourceRef="closeRestaurant" targetRef="allTablesDeleted" />
    <bpmn:sequenceFlow id="Flow_1cc7pcd" sourceRef="restaurantTurnedOn" targetRef="initializeRestaurantUI" />
