  "schemaVersion": 19,
  "id": "DisplayMenuAndOrder",
  "components": [
    {
      "text": "# Display Menu And Order",
      "type": "text",
      "layout": {
        "row": "Row_17jzbws",
        "columns": null
      },
      "id": "Field_0ynyqo1"
    },
    {
      "label": "Customer",
      "type": "textfield",
      "layout": {
        "row": "Row_1ciqvwl",
        "columns": null
      },
      "id": "Field_0sml2st",
      "key": "tableUi.customerId"
    },
    {
      "label": "Menu",
      "components": [
        {
          "type": "table",
          "layout": {
            "row": "Row_1fhwv57",
            "columns": null
          },
          "label": "Table",
          "rowCount": 10,
          "columns": [
            {
              "label": "Name",
              "key": "name"
            },
            {
              "label": "Description",
              "key": "description"
            },
            {
              "label": "Cost",
              "key": "cost"
            },
            {
              "label": "Category",
              "key": "category"
            }
          ],
          "id": "Field_1i3izp8",
          "dataSource": "=menuItemList"
        }
      ],
      "showOutline": true,
      "type": "group",
      "layout": {
        "row": "Row_1eir2lm",
        "columns": null
      },
      "id": "Field_0q5s029"
    },
    {
      "label": "Order",
      "components": [
        {
          "label": "Select Item To Order",
          "type": "radio",
          "layout": {
            "row": "Row_0n5onqh",
            "columns": null
          },
          "id": "Field_1cxityb",
          "key": "orderedItem",
          "valuesKey": "orderListNames",
          "validate": {
            "required": false
          }
        },
        {
          "label": "Ready for Pickup",
          "type": "checklist",
          "layout": {
            "row": "Row_0n5onqh",
            "columns": null
          },
          "id": "Field_1w0vxs4",
          "key": "readyForPickup",
          "readonly": true,
          "valuesExpression": "=orderListPrepared"
        },
        {
          "label": "Number To Order",
          "type": "number",
          "layout": {
            "row": "Row_0n5onqh",
            "columns": null
          },
          "id": "Field_0pzyptl",
          "key": "numberOrdered",
          "defaultValue": 0,
          "validate": {
            "required": true,
            "max": 99,
            "min": "0"
          }
        },
        {
          "label": "Place My Order",
          "type": "checkbox",
          "layout": {
            "row": "Row_1onuhrd",
            "columns": null
          },
          "id": "Field_0x4w11b",
          "key": "orderPlaced"
        },
        {
          "label": "I Want My Bill",
          "type": "checkbox",
          "layout": {
            "row": "Row_1onuhrd",
            "columns": null
          },
          "id": "Field_06zsevb",
          "key": "billRequested"
        }
      ],
      "showOutline": true,
      "type": "group",
      "layout": {
        "row": "Row_14qmxxr",
        "columns": null
      },
      "id": "Field_1pj6ze8"
    },
    {
      "text": "{\n  \"tableUi\":{\"customerId\":\"Leslie\"},\n  \"menuItemList\":[\n  {\"name\":\"A\", \"description\":\"A description\", \"cost\":\"20.00\",\"category\":\"starter\"},\n  {\"name\":\"B\", \"description\":\"B description\", \"cost\":\"120.00\",\"category\":\"main\"},\n  {\"name\":\"C\", \"description\":\"C description\", \"cost\":\"50.00\",\"category\":\"dessert\"}\n  ],\n  \"orderList\":[\n  {\"name\":\"A\", \"number\":0, \"prepared\":false},\n  {\"name\":\"B\", \"number\":0, \"prepared\":false},\n  {\"name\":\"C\", \"number\":0, \"prepared\":false}\n  ],\n  \"orderListNames\":[\"A\",\"B\",\"C\"],\n  \"orderListPrepared\":[\"false\",\"true\",\"false\"]\n}",
      "type": "text",
      "layout": {
        "row": "Row_0unyygl",
        "columns": null
      },
      "id": "Field_0twj5dv"
    }
  ],
  "type": "default"
