    <bpmn:sendTask id="deleteCustomerMenuItem" name="Delete Customer Menu Item" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendMessage:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="_deleteCustomerMenuItem" target="messageName" />
          <zeebe:input source="=menu.Customer_Menu_Item_Name" target="correlationKey" />
          <zeebe:input source="publish" target="correlationType.type" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
