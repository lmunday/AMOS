    <bpmn:sendTask id="getMenuItemList" name="Get Menu Item List" zeebe:modelerTemplate="Template_2terfy1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
