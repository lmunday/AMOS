    <bpmn:sequenceFlow id="Flow_1lobd6l" sourceRef="returnCustomerMenuItem" targetRef="Gateway_0mqz50u" />
    <bpmn:sequenceFlow id="Flow_1tsb0ii" sourceRef="Gateway_0mqz50u" targetRef="getNextMenuItem" />
    <bpmn:sequenceFlow id="Flow_1dq8946" sourceRef="getNextMenuItem" targetRef="allMenuItemsCreated" />
