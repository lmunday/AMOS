    <bpmn:scriptTask id="getCustomerMenuItem" name="Get Next Customer Menu ITem">
      <bpmn:extensionElements>
        <zeebe:script expression="=(Customer_Menu_Item_List[Index])" resultVariable="Customer_Menu_Item_Name" />
        <zeebe:ioMapping>
          <zeebe:input source="=menu.Index" target="Index" />
          <zeebe:input source="=menu.Customer_Menu_Item_List" target="Customer_Menu_Item_List" />
          <zeebe:output source="=Customer_Menu_Item_Name" target="menu.Customer_Menu_Item_Name" />
          <zeebe:output source="=menu.Index+1" target="menu.Index" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0euoi2t</bpmn:incoming>
      <bpmn:outgoing>Flow_09yh1xw</bpmn:outgoing>
    </bpmn:scriptTask>
