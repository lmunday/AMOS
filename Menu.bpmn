          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.message.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07dtrt8</bpmn:incoming>
      <bpmn:outgoing>Flow_0yqz03b</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="menuDeleted" name="Menu Deleted">
      <bpmn:incoming>Flow_1przwje</bpmn:incoming>
