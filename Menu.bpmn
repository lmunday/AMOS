  <bpmn:collaboration id="Menu" name="Menu">
    <bpmn:participant id="menu" name="Menu" processRef="menuProcess" />
    <bpmn:textAnnotation id="TextAnnotation_0z640r9">
      <bpmn:text>Need a delay to ensure all menu items have been displayed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_06a4tmf" associationDirection="None" sourceRef="displayMenu" targetRef="TextAnnotation_0z640r9" />
  </bpmn:collaboration>
  <bpmn:process id="menuProcess" name="Menu Process" isExecutable="true">
    <bpmn:startEvent id="createMenu" name="Create Menu">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=tableLocation" target="menu.location" />
          <zeebe:output source="=customerId" target="menu.customerId" />
          <zeebe:output source="=[]" target="menu.Menu_Item_List" />
          <zeebe:output source="=restaurantId" target="menu.restaurantId" />
          <zeebe:output source="=1" target="menu.Index" />
          <zeebe:output source="=[]" target="menu.Customer_Menu_Item_List" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_07dtrt8</bpmn:outgoing>
